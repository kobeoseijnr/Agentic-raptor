# ---------------------------------------------------------------------------
# Agentic RAPTOR — track CODE, not generated data.
#
# artifacts/ alone is ~2.3 GB of run directories, netlists, SPICE output and
# model checkpoints. It is regenerated by running the pipeline, and putting it
# in git would make the history unusable while proving nothing: the results
# that matter are reproduced from the code plus the frozen corpus.
# ---------------------------------------------------------------------------

# generated experiment output
artifacts/
datasets/

# third-party dependency: AnalogGym + sky130 PDK.
# Large, externally maintained, and required at runtime via a relative path
# (agentic_raptor/electrical/__init__.py resolves ../RAPTOR_Legacy).
# Keep it beside the repo; do not vendor it into history.
RAPTOR_Legacy/

# model weights and checkpoints
*.pt
*.pth
*.safetensors
*.bin
*.ckpt

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.venv/
venv/

# simulator scratch
*.raw
acdata.txt
ngspice_*.log

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# third-party clones (each has its own .git). Embedding them would make
# clones of THIS repo contain empty, unfetchable directories.
Agentic_Raptor/repositories/

# 157 MB file inventory of the original RAPTOR tree. Generated data, and
# over GitHub's 100 MB per-file limit. Regenerate with _separation_inventory.py.
ORIGINAL_RAPTOR_FILE_INVENTORY.csv
